# Copy to .env and fill in real values:  cp .env.example .env
#
# Nothing here has a fallback. docker-compose.yml uses ${VAR:?...} and the Python
# config loader raises on a missing variable, so an unset value fails at startup
# with the variable's name rather than silently running with a default.

# --- Postgres: detected episodes and application state (never raw readings) ---
POSTGRES_USER=vigil
POSTGRES_PASSWORD=
POSTGRES_DB=vigil
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Kafka ---
# Host-side bootstrap. Services running inside the compose network use kafka:9092.
KAFKA_BOOTSTRAP=localhost:19092
# KRaft needs a stable cluster id; regenerating it orphans the existing log dir.
# Generate one with:  python -c "import uuid,base64;print(base64.urlsafe_b64encode(uuid.uuid4().bytes).rstrip(b'=').decode())"
KAFKA_CLUSTER_ID=

# --- Topics ---
READINGS_TOPIC=sensor.readings
# Partition count is the ceiling on consumer parallelism; the scale harness sweeps
# consumer count against this (docs/SCALE.md).
READINGS_PARTITIONS=6

# Operational context: deploy markers, and the pipeline-health signal from the
# reconciliation harness in Phase 2. Low volume, single partition, read in full by every
# consumer -- this is the wire the core contribution runs on.
CONTEXT_TOPIC=ops.context

# Window scores emitted by the Flink job, written inside a Kafka transaction and committed
# on checkpoint completion. Consumers must read committed-only to get the exactly-once view.
SCORES_TOPIC=detections.window_scores

# --- Live source: the public TDengine solar-fleet feed ---
# Open broker, no auth, QoS 0. No SLA, so the bridge holds one connection and backs off
# exponentially on reconnect. Topics: sites, inverters, strings, weather, grid.
# 'inverters' is the default working set; 'strings' is the high-rate topic used for scale
# tests (~500 msg/s observed); '#' is for exploration only.
MQTT_HOST=mqtt.tdengine.com
MQTT_PORT=1883
MQTT_TOPIC=inverters
