# Copy to .env and fill in real values:  cp .env.example .env
#
# Nothing here has a fallback. docker-compose.yml uses ${VAR:?...} and the Python
# config loader raises on a missing variable, so an unset value fails at startup
# with the variable's name rather than silently running with a default.

# --- Postgres: detected episodes and application state (never raw readings) ---
POSTGRES_USER=vigil
POSTGRES_PASSWORD=
POSTGRES_DB=vigil
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Kafka ---
# Host-side bootstrap. Services running inside the compose network use kafka:9092.
KAFKA_BOOTSTRAP=localhost:19092
# KRaft needs a stable cluster id; regenerating it orphans the existing log dir.
# Generate one with:  python -c "import uuid,base64;print(base64.urlsafe_b64encode(uuid.uuid4().bytes).rstrip(b'=').decode())"
KAFKA_CLUSTER_ID=

# --- Topics ---
READINGS_TOPIC=sensor.readings
# Partition count is the ceiling on consumer parallelism; the scale harness sweeps
# consumer count against this (docs/SCALE.md).
READINGS_PARTITIONS=6

# Operational context: deploy markers, and the pipeline-health signal from the
# reconciliation harness in Phase 2. Low volume, single partition, read in full by every
# consumer -- this is the wire the core contribution runs on.
CONTEXT_TOPIC=ops.context

# Window scores emitted by the Flink job, written inside a Kafka transaction and committed
# on checkpoint completion. Consumers must read committed-only to get the exactly-once view.
SCORES_TOPIC=detections.window_scores

# --- Live source: the public TDengine solar-fleet feed ---
# Open broker, no auth, QoS 0. No SLA, so the bridge holds one connection and backs off
# exponentially on reconnect. Topics: sites, inverters, strings, weather, grid.
# 'inverters' is the default working set; 'strings' is the high-rate topic used for scale
# tests (~500 msg/s observed); '#' is for exploration only.
MQTT_HOST=mqtt.tdengine.com
MQTT_PORT=1883
MQTT_TOPIC=inverters

# --- ClickHouse: the serving store (ADR-006, ADR-045) ---
# High-volume OLAP only: raw readings and per-window detector scores. Episodes and app
# state stay in Postgres above. The dashboard's time-series and rollup queries read here.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=vigil
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=vigil

# --- Iceberg lake on MinIO: the durable event lake and reconciliation truth store ---
# The catalog is a JDBC catalog in the Postgres above (ADR-043), so there is no separate
# catalog service. MinIO is the S3-compatible object store holding the data files.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=vigil
MINIO_ROOT_PASSWORD=
LAKE_BUCKET=vigil-lake
LAKE_NAMESPACE=vigil
# Host-side S3 endpoint. Inside the compose network this is http://minio:9000.
LAKE_S3_ENDPOINT=http://localhost:9000

# --- VLM explainer (ADR-004, B-1) ---
# Explanations are generated for flagged windows only, on a hosted endpoint, off the hot
# path. All three are optional: with no key the explainer reports itself unavailable and
# detection is unaffected. Any OpenAI-compatible chat-completions endpoint that accepts an
# image part will do.
VLM_ENDPOINT=
VLM_API_KEY=
VLM_MODEL=

# Claude as the chart reader (ADR-041), preferred over the endpoint above when set.
# The key is read from this variable only -- no SDK credential chain, no token file --
# so whether the explainer is configured has exactly one answer. Optional like the rest:
# unset means episodes carry no explanation and detection is unaffected.
ANTHROPIC_API_KEY=
# Optional overrides. Defaults: claude-sonnet-5, 20 s, 400 output tokens.
VLM_CLAUDE_MODEL=
VLM_TIMEOUT_S=
VLM_MAX_TOKENS=
