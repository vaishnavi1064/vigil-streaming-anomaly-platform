{
  "__comment": "Every panel here queries a metric vigil.api.metrics actually exports. Panels for Kafka consumer lag, per-detector latency and Flink checkpoint duration are deliberately absent rather than present-and-empty: the first needs an exporter k8s/ does not deploy, and the other two are reported by the evaluation harness rather than scraped. A dashboard of empty panels teaches an operator to ignore it.",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "datasource", "uid": "grafana" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Correctness",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Reconciliation drift",
      "description": "Sum of per-channel (sequence span - readings) from the most recent run. Zero is the platform's central claim. Shows 'No data' rather than 0 when no run has ever been recorded, which is a different state and must look different.",
      "id": 1,
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "vigil_reconciliation_drift",
          "instant": true,
          "legendFormat": "drift"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "noValue": "never measured",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Broker-offset drift",
      "description": "The independent audit: what the broker retained against what the harness consumed. Derived differently from the ledger, so agreement between the two is the only reason to believe either.",
      "id": 2,
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "vigil_reconciliation_offset_drift",
          "instant": true,
          "legendFormat": "offset drift"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "noValue": "never measured",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Per-channel sequence gap",
      "description": "Sequence span minus distinct readings, per channel, computed on the serving store. Non-zero means the identity invariant does not hold. A producer restart also shows here, because a restarted producer reissues sequence numbers (ADR-046).",
      "id": 3,
      "gridPos": { "h": 5, "w": 14, "x": 10, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "vigil_channel_sequence_gap",
          "legendFormat": "{{channel}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "row",
      "title": "Throughput",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 101,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Ingest rate into the serving store",
      "description": "Rate of rows written to ClickHouse. Rows, not distinct readings: a replay writes duplicates that collapse later at merge time, so a spike here without a matching rise in readings is a replay rather than new data.",
      "id": 4,
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(vigil_reading_rows_total[5m])",
          "legendFormat": "rows/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" },
          "unit": "rps"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "type": "timeseries",
      "title": "Distinct readings per channel",
      "description": "Counted by identity (uniqExact over seq and event time), so a replayed batch does not inflate it.",
      "id": 5,
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "vigil_readings_total",
          "legendFormat": "{{channel}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "row",
      "title": "Health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 102,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Episode store",
      "description": "Whether the API could reach Postgres on the last scrape. Postgres also holds the Iceberg catalog (ADR-043), so this being down is two outages.",
      "id": 6,
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "vigil_postgres_up",
          "instant": true,
          "legendFormat": "postgres"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "down", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "up", "color": "green", "index": 1 } } }
          ],
          "noValue": "no scrape",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Serving store",
      "description": "Whether the API could reach ClickHouse. Down means blank serving panels; episodes still persist and detection is unaffected.",
      "id": 7,
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "vigil_clickhouse_up",
          "instant": true,
          "legendFormat": "clickhouse"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "down", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "up", "color": "green", "index": 1 } } }
          ],
          "noValue": "no scrape",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Episodes",
      "description": "Detected episodes in Postgres. Episodes live only there; ClickHouse holds no mirror of them (ADR-045).",
      "id": 8,
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "vigil_episodes_total",
          "instant": true,
          "legendFormat": "episodes"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "mappings": [], "noValue": "no scrape", "unit": "short" },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Disturbed health windows",
      "description": "Windows the reconciliation harness graded as not-ok. Conditioning attributes anomalies overlapping these to the pipeline rather than paging, so a sustained rise quietly reduces detection sensitivity.",
      "id": 9,
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "vigil_pipeline_health_disturbed_windows",
          "legendFormat": "disturbed windows"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    }
  ],
  "preload": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["vigil", "reconciliation", "anomaly-detection"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": ""
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "utc",
  "title": "Vigil: correctness, throughput and health",
  "uid": "vigil-main",
  "version": 1,
  "weekStart": ""
}
